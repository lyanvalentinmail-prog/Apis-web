# ---------------------------------------------------------------------------
# API de stickers Brat — variables de entorno
# Copia este archivo como .env en apps/api (local) o cárgalas en Vercel.
# ---------------------------------------------------------------------------

# Puerto del servidor local
PORT=4000

# URL pública de la API (se usa en CORS, cookies y en las redirecciones OAuth)
API_BASE_URL=http://localhost:4000

# Orígenes permitidos para el navegador, separados por coma.
# En Vercel pon aquí la URL de tu web: https://tu-web.vercel.app
# Si lo dejas vacío se permite cualquier origen (cómodo en local).
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Seguridad
# ---------------------------------------------------------------------------
# ¡Obligatorio en producción! Genera uno con: openssl rand -base64 48
AUTH_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Duración de la sesión web en segundos (30 días)
SESSION_TTL=2592000

# ---------------------------------------------------------------------------
# Persistencia (elige una; por defecto funciona en local sin configurar nada)
#   memory   → volátil (tests)
#   file     → JSON en disco (local) o /tmp en Vercel
#   kv       → Vercel KV / Upstash Redis
#   postgres → Neon, Supabase, Vercel Postgres...
# ---------------------------------------------------------------------------
STORE_DRIVER=file

# Vercel KV / Upstash (si usas STORE_DRIVER=kv)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Postgres (si usas STORE_DRIVER=postgres). Instala `pg`: npm i pg
DATABASE_URL=

# ---------------------------------------------------------------------------
# Límites (peticiones por minuto)
# ---------------------------------------------------------------------------
RATE_LIMIT_ANON_MINUTE=30
RATE_LIMIT_FREE_MINUTE=60
RATE_LIMIT_PRO_MINUTE=600

# Caché HTTP de las imágenes generadas (segundos)
IMAGE_CACHE_MAX_AGE=604800

# ---------------------------------------------------------------------------
# OAuth opcional (si lo dejas vacío, esos botones se ocultan)
# ---------------------------------------------------------------------------
# GitHub: https://github.com/settings/developers
# Authorization callback URL: https://TU-API.vercel.app/v1/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://TU-API.vercel.app/v1/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# A dónde vuelve el usuario tras iniciar sesión con OAuth
WEB_URL=http://localhost:5173
