# ---------------------------------------------------------------------------
# Web (Vite + React) — variables de entorno
# Copia este archivo como .env en apps/web (local) o cárgalas en Vercel.
# ---------------------------------------------------------------------------

# URL pública de tu API desplegada (sin barra final).
# En local NO hace falta: Vite hace proxy de /api -> http://localhost:4000.
VITE_API_URL=https://tu-api.vercel.app/v1

# (solo local) hacia dónde reenvía Vite el prefijo /api
VITE_API_PROXY_TARGET=http://localhost:4000
